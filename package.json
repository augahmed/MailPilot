{
  "name": "mailpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "node scripts/tauri.mjs build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "lint": "npm run lint --workspace frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:icons": "tauri icon src-tauri/icons/source.svg --output src-tauri/icons",
    "prepare:embedding": "node scripts/prepare-embedding.mjs",
    "test:embedding:package": "node scripts/smoke-embedding.mjs",
    "test:embedding:assets": "node --test scripts/embedding-artifacts.test.mjs",
    "test:indexing:native": "node scripts/smoke-indexing.mjs",
    "test:search:native": "node scripts/smoke-search.mjs",
    "test:search:hybrid": "node scripts/smoke-hybrid-search.mjs",
    "test:categories:native": "node scripts/smoke-categories.mjs",
    "test:classification:native": "node scripts/smoke-classification.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "prettier": "3.9.10"
  }
}
